{
  "name": "sereus-chat",
  "private": true,
  "description": "Sereus Chat app family. Workspace root for packages/*, apps/cli and test/stack; the other apps are not members (docs/app-family.md).",
  "packageManager": "yarn@4.3.1",
  "workspaces": [
    "packages/*",
    "apps/cli",
    "test/stack"
  ],
  "scripts": {
    "stack": "bash scripts/use-stack.sh",
    "relay": "sh scripts/relay.sh",
    "cli": "yarn workspace serchat build && node apps/cli/dist/serchat.js"
  },
  "resolutions": {
    "@optimystic/db-core": "1.12.1",
    "@optimystic/db-p2p": "1.12.1",
    "@optimystic/db-p2p-storage-rn": "1.12.1",
    "@optimystic/quereus-plugin-crypto": "1.12.1",
    "@optimystic/quereus-plugin-optimystic": "1.12.1",
    "@quereus/quereus": "4.20.2",
    "@serfab/cadre-core": "1.14.0",
    "p2p-fret": "1.0.2",
    "@libp2p/interface": "npm:3.3.0",
    "@libp2p/peer-id": "npm:6.0.15",
    "@multiformats/multiaddr": "13.0.3",
    "libp2p": "npm:3.3.11",
    "@noble/hashes": "npm:2.2.0"
  }
}
