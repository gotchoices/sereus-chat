@@ -5,8 +5,15 @@ export function byteArrayToBuffer(value) {
         return null;
     }
     const length = value.length;
-    const ret = new Uint8Array(length);
     const isString = typeof value === 'string';
+    if (!isString && length >= 96) {
+        // One bulk copy through a direct buffer instead of crossing into Java once per byte
+        // (see arrayToNativeByteArray).
+        const direct = java.nio.ByteBuffer.allocateDirect(length);
+        direct.put(value);
+        return new Uint8Array(ArrayBuffer.from(direct)).slice();
+    }
+    const ret = new Uint8Array(length);
     for (let i = 0; i < length; i++) {
         ret[i] = isString ? value.charCodeAt(i) : value[i];
     }
