diff --git a/sqlite.common.js b/sqlite.common.js
index 2bd0e28c25ca02cfc5c2caf12a1d900997826c20..f57436a99d1b02a55024c7418a06768caec6c9de 100644
--- a/sqlite.common.js
+++ b/sqlite.common.js
@@ -1,9 +1,37 @@
 export function isNothing(x) {
     return x === undefined || x === null;
 }
+// One direct buffer, reused, for bytes crossing between JS and Java. Passing a JS ArrayBuffer to
+// Java instead hands over a new java.nio.DirectByteBuffer held by a JNI global reference
+// until V8 collects the ArrayBuffer; at a call per blob, a fast phone reaches Android's
+// 51,200-reference limit and aborts ("global reference table overflow"). Copying in JS into
+// a view made once, then one bulk transfer on the Java side, creates no reference per call.
+let scratch = null;
+let scratchView = null;
+function scratchFor(size) {
+    if (!scratch || scratch.capacity() < size) {
+        let capacity = 65536;
+        while (capacity < size)
+            capacity *= 2;
+        scratch = java.nio.ByteBuffer.allocateDirect(capacity);
+        scratchView = new Uint8Array(ArrayBuffer.from(scratch));
+    }
+    return scratch;
+}
+export function scratchBuffer(size) {
+    return { buffer: scratchFor(size), view: scratchView };
+}
 export function arrayToNativeByteArray(val) {
     const length = val.length;
     const result = Array.create('byte', length);
+    if (ArrayBuffer.isView(val) && length >= 64) {
+        // One bulk copy (see scratchFor) instead of crossing into Java once per byte.
+        const { buffer, view } = scratchBuffer(length);
+        view.set(new Uint8Array(val.buffer, val.byteOffset, val.byteLength), 0);
+        buffer.clear();
+        buffer.get(result, 0, length);
+        return result;
+    }
     for (let i = 0; i < length; i++) {
         result[i] = val[i];
     }
