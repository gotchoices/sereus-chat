<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Scanning an invitation QR code (story 03: "she scans the code again").
         The scanner already calls `Camera.requestCameraPermission()`, but Android
         refuses to grant a permission the manifest never declared, so the request
         came back denied and `useCameraDevice('back')` returned null — which the
         screen honestly reported as "Camera unavailable". It reads like the camera
         is missing, e.g. on an emulator; on a real phone it was this.
         `required="false"` so a device with no camera can still install and use
         links instead. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- usesCleartextTraffic is "true" in EVERY build, not the template's
         ${usesCleartextTraffic} placeholder (which React Native's Gradle plugin sets
         to false for release). Relays are reached over ws:// — relay.sereus.org
         listens on /tcp/4011/ws, and "run your own on a spare machine" means plain
         ws on a home address — and a release build refused all of it: OkHttp
         enforces the cleartext policy on WebSockets, libp2p swallowed the error, and
         the app sat at "Connecting to your relay" forever. Found on the first
         published APK, 2026-09-30; every earlier test was a debug build.
         Safe because the WebSocket is only a wrapper: every libp2p connection
         inside it is Noise-encrypted and authenticated to the pinned peer id. -->
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="true"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!-- Custom-scheme fallback: chat://invite/<token>.  Works whenever the
             app is installed (no domain verification needed) — handy for
             same-device / pre-domain testing. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="chat" />
            <!-- Canonical scheme (design/specs/mobile/navigation.md).  `chat`
                 is kept as an alias so existing links keep working. -->
            <data android:scheme="sereus" />
        </intent-filter>

        <!-- Android App Link: https://sereus.org/chat/invite/<token>.  With
             autoVerify + a hosted https://sereus.org/.well-known/assetlinks.json
             (APEX — App Links only read the host root, never /chat/.well-known),
             the OS opens the app directly for these links; without the app, they
             load the web landing page.  Association files: ../../../../web/.well-known/
             (merged into the apex on deploy — see web/publish.sh). -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <!-- EXACT paths, matching the iOS association file. A bare prefix
                 claimed more than the app handles: "/chat/relay" also matched
                 /chat/relays.html, so every "find a relay" link the app opened was
                 routed straight back into the app, which has no screen for it, and
                 looked like a button that did nothing. -->
            <data
                android:scheme="https"
                android:host="sereus.org"
                android:pathPrefix="/chat/invite/" />
            <!-- Relay offers: /chat/relay?addr=… (the query is not part of the
                 path). -->
            <data
                android:scheme="https"
                android:host="sereus.org"
                android:path="/chat/relay" />
        </intent-filter>
      </activity>
    </application>
</manifest>
