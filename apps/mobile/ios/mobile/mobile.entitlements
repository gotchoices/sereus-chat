<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  iOS Universal Links for https://sereus.org/chat/invite/<token>.
	  The domain is the apex sereus.org (path-based), so this requires
	  web/.well-known/apple-app-site-association (chat's entry) to be MERGED into
	  https://sereus.org/.well-known/apple-app-site-association — Universal Links
	  only read the host root, never /chat/.well-known.  web/publish.sh does the
	  merge without clobbering other apps' entries.

	  This file must be wired into the Xcode target once:
	    Target "mobile" → Signing & Capabilities → + Associated Domains
	    (or Build Settings → Code Signing Entitlements → mobile/mobile.entitlements)
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:sereus.org</string>
	</array>
</dict>
</plist>
