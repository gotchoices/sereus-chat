{
  "name": "@chat/core",
  "version": "0.0.0",
  "private": true,
  "description": "Sereus Chat's shared core: protocol, model, stores. Platform-free; see docs/app-family.md.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sereus": {
      "types": "./dist/sereus/index.d.ts",
      "default": "./dist/sereus/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "default": "./dist/diagnostics/index.js"
    },
    "./package.json": "./package.json",
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "codegen": "node scripts/gen-schema.mjs",
    "build": "node scripts/gen-schema.mjs && tsc -p tsconfig.build.json",
    "watch": "node scripts/gen-schema.mjs && tsc -p tsconfig.build.json --watch",
    "typecheck": "node scripts/gen-schema.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/gen-schema.mjs && vitest run"
  },
  "peerDependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.0",
    "@quereus/quereus": "^4.20.3",
    "@serfab/cadre-core": "^1.17.0"
  },
  "devDependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/circuit-relay-v2": "4.2.14",
    "@libp2p/crypto": "5.1.24",
    "@libp2p/identify": "4.1.15",
    "@libp2p/websockets": "10.1.22",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.2.0",
    "@optimystic/db-p2p": "1.15.0",
    "@quereus/quereus": "4.20.3",
    "@serfab/cadre-core": "1.17.0",
    "@types/node": "^24.0.0",
    "libp2p": "3.3.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
