{
  "name": "@chat/strand-drive",
  "version": "0.0.0",
  "private": true,
  "description": "A strand's shared drive: folders and files as rows in the strand's database (a schema fragment any sApp includes), each file naming a blob. Built to move into the sereus stack (gotchoices/sereus#62).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@quereus/quereus": "5.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
