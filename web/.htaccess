# Deployed to sereus.org/chat/ by publish.sh. Needs mod_rewrite and
# `AllowOverride FileInfo` (or All) for this directory; without them these rules
# are ignored and both paths below return 404.
#
# The app's deep links are paths with no file behind them. When the link is not
# handed to the app (app not installed, or opened on a computer), the browser
# requests the path itself, and these rules serve the page that explains what to
# do. Query strings (relay?addr=…) are kept as they are.
RewriteEngine On
RewriteBase /chat/

# https://sereus.org/chat/invite/<token>  →  invite.html (reads the token from the path)
RewriteRule ^invite/[^/]+/?$ invite.html [L]

# https://sereus.org/chat/relay?addr=…  →  relay.html
RewriteRule ^relay/?$ relay.html [L]
