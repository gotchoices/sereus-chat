-- Sereus Chat sApp schema — applied to every chat strand.
-- StrandDatabase wraps this DDL in `declare schema App { … }; apply schema App;`
-- so tables are referenced as App.Member / App.Message / App.Attachment.
--
-- Shapes follow design/specs/domain/schema.md and ops.md.  Two things are
-- deliberate and must not be "tidied" back:
--   · Message.Id is a client-generated UUID, never a counter.  A monotonic id
--     computed as max(Id)+1 lets two concurrent writers pick the same value;
--     upstream then silently keeps one and tells both they succeeded
--     (optimystic-concurrent-same-pk-insert-silent-lww).
--   · There is no delivery or read status anywhere.  A reply is the evidence a
--     message was read.

-- NULLABILITY IS EXPLICIT HERE, and has to be.  Quereus follows the Third
-- Manifesto and defaults a column to NOT NULL (`schema/column.js`:
-- `notNull: defaultNotNull`), which is the OPPOSITE of the SQL convention this
-- file was first written against.  Without the `null` markers below, every
-- optional column was silently mandatory: `insertMessage` passes a null
-- `ReplyToId` and omits `EditedAt`, so sending a message failed with
-- `NOT NULL constraint failed` — on a column this file declares optional.

-- CHANGE NOTIFICATION. Every table is tagged `"optimystic.network_watch" = true`
-- (sereus 1.12, docs/strands.md "Change notifications (reactivity)"). On a node
-- built with `strandReactivity` a `Database.watch` on it wakes when another
-- machine commits; on a node without it the tag only logs a warning and local
-- wakes continue, so it is safe to ship unconditionally.
--
-- FRESH IDS. `Message.Id` and `Attachment.Id` are tagged `"optimystic.fresh" = true`:
-- the app generates each as a new random UUID, so no other member's write can collide
-- with one. In offline mode (docs/async-writes.md) that lets the stack judge an ordinary
-- send `assured` (nobody else's write can make it fail) instead of "may not go through".
-- A tag only: rows and storage are unchanged. `Member.Id` (a peer id) and `Reaction`'s
-- composite key are not fresh and stay untagged.

table Member (
    Id text primary key,                -- libp2p Peer ID of the participating member
    Name text not null check (length(Name) between 1 and 100),
    AvatarUri text null                 -- optional; Quereus defaults to NOT NULL
) with tags ("optimystic.network_watch" = true);

table Message (
    Id text primary key with tags ("optimystic.fresh" = true),  -- client-generated UUID
    MemberId text not null,
    Content text not null,
    Timestamp datetime not null,        -- asserted by the sender; not authoritative
    ReplyToId text null,                -- quote-reply target, null when not a reply
    EditedAt datetime null,             -- set when edited in place; no version chain
    foreign key (MemberId) references Member(Id)
) with tags ("optimystic.network_watch" = true);

-- THE MESSAGE LIST reads the newest page: `order by Timestamp desc, Id desc limit N`. With
-- this index Optimystic (1.26, gotchoices/Optimystic#52) walks it backwards and stops after N
-- rows; without it every read scans and sorts the whole conversation (about 2 s on a Galaxy
-- S7 at 5,000 messages). Both columns are not null, which an ordered walk needs.
index MessageByTime on Message (Timestamp, Id);

table Attachment (
    Id text primary key with tags ("optimystic.fresh" = true),
    MessageId text not null,
    Type text not null,                 -- image | video | file | voice
    Uri text null,                      -- not written since 0.4.0 (where a device caches a file is its own business)
    MimeType text null,
    Name text null,
    ByteSize integer null,
    DurationMs integer null,            -- video and voice
    Blob text null,                     -- the content's ref (docs/blobs.md), e.g. 'chunks:1:<sha-256>'
    foreign key (MessageId) references Message(Id)
) with tags ("optimystic.network_watch" = true);

-- BLOBS (docs/blobs.md): a file's bytes, until Quereus/Optimystic store large values natively.
-- Content-addressed and content-keyed: two members storing the same bytes store the same rows,
-- and a repeat insert is not a conflict. A file is split into chunks small enough for a block,
-- written a few per transaction; `Blob` lists them in order. Rows are added, never changed.
table BlobChunk (
    Hash text primary key,              -- sha-256 of Bytes, lowercase hex
    Bytes blob not null
) with tags ("optimystic.content_key" = true, "optimystic.network_watch" = true);

table Blob (
    Id text primary key,                -- sha-256 of the whole content, lowercase hex
    Size integer not null,
    ChunkSize integer not null,
    Chunks text not null                -- JSON array of chunk hashes, in order
) with tags ("optimystic.content_key" = true, "optimystic.network_watch" = true);

table Reaction (
    MessageId text not null,
    MemberId text not null,             -- attributed; never an anonymous tally
    Symbol text not null,               -- open set, not a curated palette
    primary key (MessageId, MemberId, Symbol),
    foreign key (MessageId) references Message(Id),
    foreign key (MemberId) references Member(Id)
) with tags ("optimystic.network_watch" = true);
